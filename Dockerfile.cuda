# amd64-only CUDA image for the standalone `mineru-mistralrs` CLI.
#
# The pinned digests are the linux/amd64 platform manifests of the CUDA 12.8.1
# Ubuntu 22.04 images (see .slim/deepwork/mineru-mistralrs-cli.md for the
# CPU/CUDA mapping and CUDA verification notes).
FROM nvidia/cuda:12.8.1-devel-ubuntu22.04@sha256:6617a625f4090c76c545a0e7d63f2e441718ef9af7f4efe7dd1242a29e289fd7 AS builder

WORKDIR /app
COPY . .

# Rust 1.89 (MSRV) via rustup; full toolchain for mistralrs/candle C/C++ deps.
RUN apt-get update \
    && apt-get install --no-install-recommends -y build-essential pkg-config libssl-dev curl \
    && rm -rf /var/lib/apt/lists/* \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain 1.89.0
ENV PATH="/root/.cargo/bin:${PATH}"

# Default to sm_80 (A100/RTX 30xx; compatible with sm_86/sm_89). H100 uses
# sm_90. When building this image yourself,
# pass a different compute capability, e.g. `--build-arg CUDA_COMPUTE_CAP=89`
# (Ada), `CUDA_COMPUTE_CAP=90` (Hopper), or `86` (Ampere consumer).
ARG CUDA_COMPUTE_CAP=80
ENV CUDA_COMPUTE_CAP=${CUDA_COMPUTE_CAP}

RUN cargo build --release --locked -p mineru --features mistralrs-cuda --bin mineru-mistralrs

# Runtime carries the CUDA runtime libraries; the host kernel driver is
# injected by the container runtime (`--gpus all`). No server is exposed, so
# no EXPOSE here.
FROM nvidia/cuda:12.8.1-runtime-ubuntu22.04@sha256:fcbbd60a5ad3db3a1c7375bf14546b369b54064c513224310b2026df50c7a9bd

RUN apt-get update \
    && apt-get install --no-install-recommends -y ca-certificates libssl3 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system mineru \
    && useradd --system --gid mineru --home-dir /data --shell /usr/sbin/nologin mineru \
    && mkdir -p /data \
    && chown mineru:mineru /data

COPY --from=builder /app/target/release/mineru-mistralrs /usr/local/bin/mineru-mistralrs

# /data holds HF model caches and is the workdir for mounted input documents.
WORKDIR /data
USER mineru
ENV HF_HOME=/data
VOLUME ["/data"]
ENTRYPOINT ["mineru-mistralrs"]
