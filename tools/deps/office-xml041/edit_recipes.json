          "\nfn attribute_value(xml: &str, key: &[u8]) -> String {\n    let mut reader = quick_xml::Reader::from_str(xml);\n    let quick_xml::events::Event::Empty(element) = reader.read_event().unwrap() else {\n        panic!(\"expected empty element\");\n    };\n    let attribute = element\n        .attributes()\n        .flatten()\n        .find(|attribute| attribute.key.as_ref() == key)\n        .unwrap();\n    unescape_attribute_utf8(&attribute).unwrap().into_owned()\n}\n\n#[test]\n",
          "\nfn attribute_value(xml: &str, key: &[u8]) -> String {\n    let mut reader = quick_xml::Reader::from_str(xml);\n    let quick_xml::events::Event::Empty(element) = reader.read_event().unwrap() else {\n        panic!(\"expected empty element\");\n    };\n    let attribute = element\n        .attributes()\n        .flatten()\n        .find(|attribute| attribute.key.as_ref() == key)\n        .unwrap();\n    unescape_attribute_utf8(&attribute).unwrap().into_owned()\n}\n\n#[test]\nfn utf8_attributes_preserve_legacy_unescape_semantics() {\n    assert_eq!(attribute_value(r#\"<x v=\"R&amp;D&#xE9;\"/>\"#, b\"v\"), \"R&D\u00e9\");\n    assert_eq!(\n        attribute_value(\"<x v=\\\"a\\tb\\nc\\rd&#9;&#10;&#13;\\\"/>\", b\"v\"),\n        \"a\\tb\\nc\\rd\\t\\n\\r\"\n    );\n    assert_eq!(\n        attribute_value(\"<x xmlns:r=\\\"urn:test\\\" r:id=\\\"r&amp;\u00e9\\\"/>\", b\"r:id\"),\n        \"r&\u00e9\"\n    );\n}\n\n#[test]\n",
