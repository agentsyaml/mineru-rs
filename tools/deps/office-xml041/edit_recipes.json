        [
          "use quick_xml::Reader;\nuse quick_xml::events::Event;\n\nuse crate::ir::Color;\n",
          "use quick_xml::events::Event;\nuse quick_xml::{Decoder, Reader};\nuse std::borrow::Cow;\n\nuse crate::ir::Color;\n\npub(crate) fn unescape_attribute_utf8<'a>(\n    attribute: &quick_xml::events::attributes::Attribute<'a>,\n) -> quick_xml::Result<Cow<'a, str>> {\n    use quick_xml::encoding::EncodingError;\n    use std::str::from_utf8;\n\n    let decoded = match &attribute.value {\n        Cow::Borrowed(bytes) => Cow::Borrowed(from_utf8(bytes).map_err(EncodingError::Utf8)?),\n        Cow::Owned(bytes) => Cow::Owned(from_utf8(bytes).map_err(EncodingError::Utf8)?.to_owned()),\n    };\n    unescape_decoded_attribute(decoded)\n}\n\npub(crate) fn decode_unescape_attribute<'a>(\n    attribute: &quick_xml::events::attributes::Attribute<'a>,\n    decoder: Decoder,\n) -> quick_xml::Result<Cow<'a, str>> {\n    let decoded = match &attribute.value {\n        Cow::Borrowed(bytes) => decoder.decode(bytes)?,\n        Cow::Owned(bytes) => Cow::Owned(decoder.decode(bytes)?.into_owned()),\n    };\n    unescape_decoded_attribute(decoded)\n}\n\nfn unescape_decoded_attribute<'a>(decoded: Cow<'a, str>) -> quick_xml::Result<Cow<'a, str>> {\n    match quick_xml::escape::unescape(&decoded)? {\n        Cow::Borrowed(_) => Ok(decoded),\n        Cow::Owned(value) => Ok(Cow::Owned(value)),\n    }\n}\n",
          1
        ]
      ]
