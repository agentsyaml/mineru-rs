          "fn utf8_attributes_preserve_legacy_unescape_semantics() {\n    assert_eq!(attribute_value(r#\"<x v=\"R&amp;D&#xE9;\"/>\"#, b\"v\"), \"R&D\u00e9\");\n    assert_eq!(\n        attribute_value(\"<x v=\\\"a\\tb\\nc\\rd&#9;&#10;&#13;\\\"/>\", b\"v\"),\n        \"a\\tb\\nc\\rd\\t\\n\\r\"\n    );\n    assert_eq!(\n        attribute_value(\"<x xmlns:r=\\\"urn:test\\\" r:id=\\\"r&amp;\u00e9\\\"/>\", b\"r:id\"),\n        \"r&\u00e9\"\n    );\n}\n\n#[test]\nfn decoder_aware_attributes_preserve_non_utf8_values() {\n    let xml = b\"<?xml version=\\\"1.0\\\" encoding=\\\"windows-1252\\\"?><x v=\\\"caf\\xe9&amp;&#x9;\\\"/>\";\n    let mut reader = quick_xml::Reader::from_reader(&xml[..]);\n    let mut buffer = Vec::new();\n    reader.read_event_into(&mut buffer).unwrap();\n    buffer.clear();\n    let decoder = reader.decoder();\n    let quick_xml::events::Event::Empty(element) = reader.read_event_into(&mut buffer).unwrap() else {\n        panic!(\"expected empty element\");\n    };\n    let attribute = element.attributes().next().unwrap().unwrap();\n    assert_eq!(\n        decode_unescape_attribute(&attribute, decoder).unwrap(),\n        \"caf\u00e9&\\t\"\n    );\n}\n\n#[test]\n",
