FROM debian:bookworm-slim@sha256:7b140f374b289a7c2befc338f42ebe6441b7ea838a042bbd5acbfca6ec875818

ARG TARGETARCH

# Debian packages are pinned to the 2025-01-01 snapshot; roll this timestamp
# forward manually to receive security updates.
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && printf '%s\n' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250101T000000Z/ bookworm main' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20250101T000000Z/ bookworm-updates main' \
        'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20250101T000000Z/ bookworm-security main' \
        > /etc/apt/sources.list \
    && apt-get update \
    && apt-get install --no-install-recommends -y \
        ca-certificates=20230311 \
        curl=7.88.1-10+deb12u8 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --system mineru \
    && useradd --system --gid mineru --home-dir /app --shell /usr/sbin/nologin mineru \
    && mkdir -p /app/output \
    && chown mineru:mineru /app/output

COPY --chmod=0755 container-binaries/${TARGETARCH}/ /usr/local/bin/

WORKDIR /app
USER mineru
ENV MINERU_API_PUBLIC_BIND_EXPOSED=true \
    MINERU_API_OUTPUT_ROOT=/app/output
EXPOSE 8000
VOLUME ["/app/output"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD curl --fail --silent --show-error http://127.0.0.1:8000/health || exit 1
CMD ["mineru-api", "--host", "0.0.0.0", "--port", "8000"]
