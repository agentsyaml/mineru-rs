from dataclasses import dataclass
from enum import Enum
from os import PathLike
from typing import Any, Dict, List, Mapping, Optional, Sequence, Union

PathArg = Union[str, PathLike[str]]

class OfficialTier(str, Enum): ...
class OfficialOcrMode(str, Enum): ...
class OfficialWorkerMode(str, Enum): ...
class OfficialRenderFormat(str, Enum): ...
class OfficialRenderMode(str, Enum): ...
class OfficialPdfLayout(str, Enum): ...

@dataclass(frozen=True)
class OfficialRuntime:
    python: Optional[PathArg] = ...
    config: Optional[PathArg] = ...
    model_dir: Optional[PathArg] = ...
    worker_mode: OfficialWorkerMode = ...
    timeout: int = ...

@dataclass(frozen=True)
class HtmlSourceContext:
    source_uri: Optional[str] = ...
    local_resource_root: Optional[PathArg] = ...
    transport_encoding: Optional[str] = ...

@dataclass(frozen=True)
class OfficialVlmConfig:
    engine: str = ...
    server_url: str = ...
    api_key: str = ...
    model: str = ...
    http_timeout: int = ...
    max_concurrency: int = ...

@dataclass(frozen=True)
class OfficialParseOptions:
    tier: Optional[OfficialTier] = ...
    ocr_mode: Optional[OfficialOcrMode] = ...
    image_analysis: Optional[bool] = ...
    page_range: Optional[str] = ...
    source_context: Optional[HtmlSourceContext] = ...
    vlm_config: Optional[OfficialVlmConfig] = ...
    vlm_server_url: Optional[str] = ...
    vlm_api_key: Optional[str] = ...
    vlm_model: Optional[str] = ...

@dataclass(frozen=True)
class OfficialLatexDelimiter:
    left: str = ...
    right: str = ...

@dataclass(frozen=True)
class OfficialLatexDelimiters:
    display: OfficialLatexDelimiter = ...
    inline: OfficialLatexDelimiter = ...

@dataclass(frozen=True)
class OfficialRenderOptions:
    mode: Optional[OfficialRenderMode] = ...
    asset_base_url: Optional[str] = ...
    standalone: Optional[bool] = ...
    document_title: Optional[str] = ...
    asset_base_path: Optional[str] = ...
    title: Optional[str] = ...
    authors: Optional[List[str]] = ...
    language: Optional[str] = ...
    identifier: Optional[str] = ...
    modified_at: Optional[str] = ...
    layout: Optional[OfficialPdfLayout] = ...
    latex_delimiters: Optional[OfficialLatexDelimiters] = ...

@dataclass(frozen=True)
class OfficialVersionMetadata:
    mineru_package: str
    schema_version: str
    bundle_name: str

@dataclass(frozen=True)
class OfficialText:
    content: str
    sidecars: Dict[str, bytes]
    kind: str = ...

@dataclass(frozen=True)
class OfficialJson:
    value: Any
    sidecars: Dict[str, bytes]
    kind: str = ...

@dataclass(frozen=True)
class OfficialBinary:
    data: bytes
    sidecars: Dict[str, bytes]
    kind: str = ...

OfficialRendered = Union[OfficialText, OfficialJson, OfficialBinary]

@dataclass(frozen=True)
class OfficialBatchItem:
    input: Union[PathArg, bytes]
    filename: Optional[str] = ...
    options: OfficialParseOptions = ...

@dataclass(frozen=True)
class OfficialBatchResult:
    index: int
    filename: str
    result: Optional["OfficialResult"] = ...
    error: Optional[str] = ...

class OfficialResult:
    @property
    def middle_json(self) -> Any: ...
    @property
    def model_json(self) -> Optional[Any]: ...
    @property
    def markdown(self) -> str: ...
    @property
    def structured_content(self) -> Any: ...
    @property
    def pages(self) -> List[Any]: ...
    @property
    def assets(self) -> Dict[str, bytes]: ...
    @property
    def warnings(self) -> List[str]: ...
    @property
    def version_metadata(self) -> OfficialVersionMetadata: ...
    def export_pages(self) -> List[Any]: ...
    async def to_dict(self, skip_defaults: bool = ...) -> Any: ...
    async def to_json(self, skip_defaults: bool = ...) -> str: ...
    @classmethod
    async def from_dict(cls, runtime: OfficialRuntime, middle: Any, assets: Optional[Mapping[str, bytes]] = ...) -> "OfficialResult": ...
    @classmethod
    async def from_json(cls, runtime: OfficialRuntime, middle: str, assets: Optional[Mapping[str, bytes]] = ...) -> "OfficialResult": ...
    async def render(self, format: Union[OfficialRenderFormat, str], options: Optional[OfficialRenderOptions] = ...) -> OfficialRendered: ...
    def save(self, root: PathArg, stem: str) -> None: ...
    def save_with_writer(self, writer: Any) -> None: ...

class OfficialParser:
    def __init__(self, runtime: Optional[OfficialRuntime] = ...) -> None: ...
    async def parse_rich(self, source: Union[PathArg, bytes], *, filename: Optional[str] = ..., options: Optional[OfficialParseOptions] = ...) -> OfficialResult: ...
    async def parse_batch_rich(self, items: Sequence[OfficialBatchItem]) -> List[OfficialBatchResult]: ...
    async def shutdown(self) -> None: ...

async def parse_rich(source: Union[PathArg, bytes], *, filename: Optional[str] = ..., options: Optional[OfficialParseOptions] = ..., runtime: Optional[OfficialRuntime] = ...) -> OfficialResult: ...
async def parse_batch_rich(items: Sequence[OfficialBatchItem], *, runtime: Optional[OfficialRuntime] = ...) -> List[OfficialBatchResult]: ...
