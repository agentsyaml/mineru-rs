{
  "name": "@alexsun-top/mineru",
  "version": "0.3.0",
  "description": "Native Node.js helpers for MinerU Rust",
  "main": "api.js",
  "types": "api.d.ts",
  "bin": {
    "mineru": "bin/mineru.js",
    "mineru-rs": "bin/mineru.js"
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agentsyaml/mineru-rs.git"
  },
  "bugs": {
    "url": "https://github.com/agentsyaml/mineru-rs/issues"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "api.js",
    "api.d.ts",
    "bin/mineru.js"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "napi": {
    "binaryName": "mineru",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ]
  },
  "scripts": {
    "build": "napi build --release --platform -- --locked",
    "test": "node __test__/command-aliases.test.js && node __test__/smoke.test.js"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.2"
  },
  "engines": {
    "node": ">=18"
  }
}
